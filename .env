# Standard Cloud Server Profile
# Moderate resource allocation for typical cloud deployments
# Assumes: Cloud server with 16-32GB RAM (t3.large or equivalent)
#
# Settings designed for:
# - Production-like performance testing
# - Medium dataset sizes
# - Typical SaaS infrastructure benchmarking
#
# Typical environment: AWS t3.large (8GB), GCP n2-standard-4 (16GB), etc.
# Available for Docker: ~8-12GB

# PostgreSQL memory configuration
# shared_buffers: 2GB (25% of typical 8GB allocation)
# effective_cache_size: 6GB (reflects 8GB container + OS cache)
DB_SHARED_BUFFERS=2GB
DB_EFFECTIVE_CACHE_SIZE=6GB
DB_WORK_MEM=48MB
DB_MAINTENANCE_WORK_MEM=512MB

# Connection pool (moderate-high for production scenarios)
DB_MAX_CONNECTIONS=150

# Worker processes (balanced parallelism)
DB_MAX_WORKER_PROCESSES=4
DB_MAX_PARALLEL_WORKERS_PER_GATHER=2
DB_MAX_PARALLEL_WORKERS=4

# Write-ahead log
DB_MAX_WAL_SIZE=1GB
DB_WAL_BUFFERS=8MB

# Query planner (SSD-based cloud storage)
DB_RANDOM_PAGE_COST=1.1

# Data volume (medium for realistic scenarios)
DATA_VOLUME=medium
