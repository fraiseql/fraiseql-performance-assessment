# Laptop Development Profile
# Light resource allocation for developer laptops
# Assumes: Consumer laptop with 8-16GB RAM, shared with IDE, browser, etc.
#
# Settings designed for:
# - Developer local testing
# - Reasonable performance without monopolizing system
# - Balance between speed and responsiveness
#
# Typical laptop: MacBook Pro, Dell XPS, ThinkPad with 8-16GB RAM
# Available for Docker: ~2-4GB (rest for OS + IDE)

# PostgreSQL memory configuration
# shared_buffers: 512MB (reasonable for laptop constraints)
# effective_cache_size: 2GB (assumes 4GB docker allocation)
DB_SHARED_BUFFERS=512MB
DB_EFFECTIVE_CACHE_SIZE=2GB
DB_WORK_MEM=32MB
DB_MAINTENANCE_WORK_MEM=256MB

# Connection pool (moderate)
DB_MAX_CONNECTIONS=100

# Worker processes (balance parallelism with resource usage)
DB_MAX_WORKER_PROCESSES=4
DB_MAX_PARALLEL_WORKERS_PER_GATHER=2
DB_MAX_PARALLEL_WORKERS=4

# Write-ahead log
DB_MAX_WAL_SIZE=512MB
DB_WAL_BUFFERS=4MB

# Query planner
DB_RANDOM_PAGE_COST=1.5

# Data volume (small to medium for reasonable query times)
DATA_VOLUME=small
