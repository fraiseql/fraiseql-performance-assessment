# Powerful Workstation Profile
# Maximum resource allocation for development workstations
# Assumes: High-end workstation or server with 32GB+ RAM
#
# Settings designed for:
# - Maximum PostgreSQL performance
# - Large dataset benchmarking
# - Development on powerful hardware (like your i7-13700K machine)
#
# Typical environment: Custom workstation (Ryzen/Intel high-end), Mac Studio, etc.
# Available for Docker: ~20-30GB

# PostgreSQL memory configuration
# shared_buffers: 8GB (25% of 32GB, good rule of thumb)
# effective_cache_size: 24GB (reflects most of available RAM for caching)
DB_SHARED_BUFFERS=8GB
DB_EFFECTIVE_CACHE_SIZE=24GB
DB_WORK_MEM=64MB
DB_MAINTENANCE_WORK_MEM=2GB

# Connection pool (high for heavy concurrent load testing)
DB_MAX_CONNECTIONS=300

# Worker processes (maximize parallelism on high-core-count CPUs)
# For i7-13700K (8P+8E cores effective 24), we use 8 workers
DB_MAX_WORKER_PROCESSES=8
DB_MAX_PARALLEL_WORKERS_PER_GATHER=4
DB_MAX_PARALLEL_WORKERS=8

# Write-ahead log (aggressive for high throughput)
DB_MAX_WAL_SIZE=4GB
DB_WAL_BUFFERS=16MB

# Query planner (optimized for fast NVMe storage)
DB_RANDOM_PAGE_COST=1.1

# Data volume (large for comprehensive benchmarking)
DATA_VOLUME=large
