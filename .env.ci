# CI/CD Pipeline Profile
# Minimal resource allocation for GitHub Actions, GitLab CI, or similar
# Assumes: Shared resource pool, limited RAM (512MB-1GB total)
#
# Settings designed for:
# - Fast startup
# - Minimal memory footprint
# - Correctness verification (not performance tuning)
#
# Typical CI environment: Ubuntu runner with 2-4GB available, shared with other tests

# PostgreSQL memory configuration
# shared_buffers: 64MB (1/4 of typical CI allocation)
# effective_cache_size: 256MB (fits in typical CI resource limits)
DB_SHARED_BUFFERS=64MB
DB_EFFECTIVE_CACHE_SIZE=256MB
DB_WORK_MEM=16MB
DB_MAINTENANCE_WORK_MEM=64MB

# Connection pool (keep small to save memory)
DB_MAX_CONNECTIONS=50

# Worker processes (minimal for fast startup)
DB_MAX_WORKER_PROCESSES=2
DB_MAX_PARALLEL_WORKERS_PER_GATHER=1
DB_MAX_PARALLEL_WORKERS=2

# Write-ahead log (minimal)
DB_MAX_WAL_SIZE=256MB
DB_WAL_BUFFERS=1MB

# Query planner (conservative for predictability)
DB_RANDOM_PAGE_COST=4.0

# Data volume (small dataset for speed)
DATA_VOLUME=small
