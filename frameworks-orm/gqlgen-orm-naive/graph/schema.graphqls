type User {
  id: ID!
  username: String!
  firstName: String
  lastName: String
  bio: String

  # NAIVE: These field resolvers cause N+1 queries
  posts: [Post!]!
  comments: [Comment!]!
}

type Post {
  id: ID!
  title: String!
  content: String
  authorId: String!

  # NAIVE: These field resolvers cause N+1 queries
  author: User!
  comments: [Comment!]!
}

type Comment {
  id: ID!
  content: String!
  postId: String!
  authorId: String!

  # NAIVE: These field resolvers cause N+1 queries
  post: Post!
  author: User!
}

type Query {
  user(id: ID!): User
  users(limit: Int = 10): [User!]!

  post(id: ID!): Post
  posts(limit: Int = 10): [Post!]!
}