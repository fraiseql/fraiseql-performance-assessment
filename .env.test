# Test Suite Profile
# Configuration for comprehensive framework performance benchmarking
# Assumes: Standard workstation with 16GB+ RAM
#
# Settings designed for:
# - Complete framework testing (23 implementations)
# - XXLarge dataset (600 users, 6K posts, 30K comments)
# - JMeter performance testing with medium load profile
# - Full QA validation (schema, queries, N+1, consistency, performance)
#
# Typical environment: Development/benchmark machine with adequate resources
# Available for Docker: ~12-16GB

# PostgreSQL memory configuration
# shared_buffers: 4GB (for xxlarge dataset)
# effective_cache_size: 12GB (reflects available RAM for caching)
DB_SHARED_BUFFERS=4GB
DB_EFFECTIVE_CACHE_SIZE=12GB
DB_WORK_MEM=64MB
DB_MAINTENANCE_WORK_MEM=1GB

# Connection pool (high for concurrent test load)
DB_MAX_CONNECTIONS=200

# Worker processes (balanced for multi-threaded JMeter)
DB_MAX_WORKER_PROCESSES=4
DB_MAX_PARALLEL_WORKERS_PER_GATHER=2
DB_MAX_PARALLEL_WORKERS=4

# Write-ahead log
DB_MAX_WAL_SIZE=2GB
DB_WAL_BUFFERS=16MB

# Query planner (optimized for NVMe/SSD)
DB_RANDOM_PAGE_COST=1.1

# Data volume (XXLarge for comprehensive benchmarking)
DATA_VOLUME=xxlarge

# Test suite specific settings
COMPOSE_PROJECT_NAME=fraiseql-test-suite
POSTGRES_PORT=5435
